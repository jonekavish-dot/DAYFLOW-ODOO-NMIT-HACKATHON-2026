# ==============================================================================
# Dayflow HRMS - Environment Configuration Template
# ==============================================================================

# Application Port (default: 3000)
PORT=3000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Timezone for work date boundaries (default: Asia/Kolkata)
DAYFLOW_TIMEZONE=Asia/Kolkata

# HMAC Token Signing Secret (change in production)
DAYFLOW_SESSION_SECRET=dayflow-super-secret-signing-key-change-in-production

# Production Database Connection String (PostgreSQL)
# When set, the application automatically uses PostgreSQL (Neon, Supabase, Vercel Postgres, Railway)
# When unset, the application automatically runs in 100% local-first SQLite mode.
# DATABASE_URL=postgresql://user:password@host:5432/dayflow?sslmode=require
